+/* Homepage-only cinematic entrance. Normal document scrolling is never intercepted. */
+body[data-page="home"] { --entrance-header: 63px; }
+body[data-page="home"] .site-header .nav { padding-left: 28px; padding-right: 28px; }
+.campus-entrance { padding: 0; position: relative; height: calc(100svh - var(--entrance-header)); background: #27372f; }
+.campus-entrance.is-enhanced { height: 340svh; }
+.entrance-frame { position: sticky; top: var(--entrance-header); height: calc(100svh - var(--entrance-header)); min-height: 460px; overflow: hidden; isolation: isolate; color: #fffdf6; }
+.entrance-photo, .entrance-canvas, .entrance-shade, .entrance-flash, .entrance-exit { position: absolute; inset: 0; width: 100%; height: 100%; }
+.entrance-photo { object-fit: cover; object-position: 48% 45%; }
+.entrance-canvas { opacity: 0; pointer-events: none; }
+.entrance-canvas canvas { width: 100%; height: 100%; display: block; }
+.is-ready .entrance-canvas { opacity: 1; }
+.entrance-shade { background: linear-gradient(180deg,rgba(9,27,26,.28), transparent 36%,rgba(10,25,22,.16) 45%,rgba(9,23,21,.85)); pointer-events: none; }
+.entrance-topline { position: absolute; top: 30px; left: 4.5%; right: 4.5%; display: flex; justify-content: space-between; gap: 16px; font: 10px var(--font-mono); letter-spacing: .15em; border-top: 1px solid #ffffff70; padding-top: 17px; }
+.entrance-copy { position: absolute; left: 7%; bottom: 115px; width: min(1000px,86%); will-change: transform,opacity; }
+.entrance-kicker { font: 10px var(--font-mono); letter-spacing: .17em; color: #e6d9b8; margin-bottom: 18px; }
+.entrance-copy h1 { color: #fffdf6; font-size: clamp(3.3rem,6.2vw,6.4rem); line-height: .98; letter-spacing: -.055em; font-weight: 500; margin-bottom: 22px; text-shadow: 0 2px 32px #13272030; }
+.entrance-copy h1 em { font-weight: 400; color: #eaddbf; }
+.entrance-copy > p:not(.entrance-kicker) { color: #ffffffd1; font-size: 14px; line-height: 1.65; }
+.entrance-enter { display: inline-flex; align-items: center; gap: 28px; color: white; text-decoration: none; font-size: 12px; padding: 11px 0 7px; border-bottom: 1px solid #ffffff85; }
+.entrance-enter span { font-size: 21px; }
+.entrance-enter:hover, .entrance-skip:hover { color: #eaddbf; }
+.entrance-bottom { position: absolute; left: 4.5%; right: 4.5%; bottom: 30px; display: flex; justify-content: space-between; align-items: center; gap: 16px; font: 10px var(--font-mono); letter-spacing: .1em; }
+.entrance-location span { color: #ddc596; margin: 0 8px; }
+.entrance-scroll { display: flex; align-items: center; gap: 15px; }
+.scroll-line { width: 1px; height: 32px; background: #ffffff40; position: relative; overflow: hidden; }
+.scroll-line::after { content: ''; position: absolute; inset: 0; background: #eaddbf; animation: scroll-cue 2.3s ease-in-out infinite; }
+@keyframes scroll-cue { 0% { transform: translateY(-110%); } 65%,100% { transform: translateY(110%); } }
+.entrance-skip { color: white; text-decoration: none; padding: 10px 0 10px 14px; }
+.entrance-skip span { margin-left: 12px; }
+.entrance-arrival { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; opacity: 0; pointer-events: none; text-shadow: 0 2px 40px #180e0a50; }
+.entrance-arrival > span { font: 10px var(--font-mono); letter-spacing: .2em; margin-bottom: 24px; }
+.entrance-arrival p { color: #fff9e8; font: 500 clamp(4rem,8vw,8rem)/.95 var(--font-display); letter-spacing: -.04em; }
+.entrance-arrival em { font-weight: 400; }
+.entrance-flash { background: #f1eee6; opacity: 0; pointer-events: none; }
+.entrance-exit { background: var(--paper); opacity: 0; pointer-events: none; }
+.entrance-progress { position: absolute; bottom: 0; left: 0; right: 0; height: 3px; background: #ffffff20; }
+.entrance-progress span { display: block; height: 100%; background: #dac191; transform: scaleX(0); transform-origin: left; }
+.campus-content { background: var(--paper); scroll-margin-top: var(--entrance-header); }
+.campus-content h2 { font-size: clamp(2rem,4vw,3.5rem); line-height: 1.15; }
+.campus-content:focus { outline: none; }
+.entrance-frame a:focus-visible { outline: 2px solid #ffe0a5; outline-offset: 7px; }
+.campus-entrance:not(.is-enhanced) .entrance-scroll { display: none; }
+@media (max-width: 780px) {
+  body[data-page="home"] .site-header .nav { padding-left: 20px; padding-right: 20px; }
+  .campus-entrance.is-enhanced { height: 280svh; }
+  .entrance-topline { top: 23px; left: 6%; right: 6%; font-size: 8px; letter-spacing: .08em; }
+  .entrance-copy { left: 7%; right: 7%; bottom: 105px; }
+  .entrance-copy h1 { font-size: clamp(2.8rem,10vw,4.6rem); }
+  .entrance-kicker { font-size: 8px; letter-spacing: .08em; }
+  .entrance-copy > p:not(.entrance-kicker) { font-size: 13px; }
+  .entrance-location { display: none; }
+  .entrance-bottom { left: 7%; right: 7%; font-size: 8px; letter-spacing: .04em; }
+}
+@media (max-height: 580px) and (min-width: 781px) {
+  .entrance-frame { min-height: 0; }
+  .entrance-copy { bottom: 65px; }
+  .entrance-copy h1 { font-size: 3rem; margin-bottom: 12px; }
+  .entrance-copy > p:not(.entrance-kicker), .entrance-kicker { display: none; }
+  .entrance-topline { top: 15px; }
+  .entrance-bottom { bottom: 15px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .campus-entrance.is-enhanced { height: calc(100svh - var(--entrance-header)); }
+  .entrance-canvas, .entrance-scroll, .entrance-progress { display: none; }
+}
+
+/* Bring the real page into the final shot instead of leaving a blank viewport. */
+.campus-entrance { z-index: 0; }
+.campus-entrance.is-enhanced + .campus-content {
+  margin-top: calc(var(--entrance-header) - 100svh);
+  opacity: var(--content-reveal, 0);
+}
+main > section:not(.campus-entrance) { position: relative; z-index: 1; background-color: var(--paper); }
+@media (prefers-reduced-motion: reduce) {
+  .campus-entrance.is-enhanced + .campus-content { margin-top: 0; opacity: 1; }
+}
diff --git a/assets/entrance.js b/assets/entrance.js
new file mode 100644
index 0000000..ef9df89
--- /dev/null
+++ b/assets/entrance.js
@@ -0,0 +1,124 @@
+const entrance = document.querySelector('#campus-entrance');
+const frame = entrance.querySelector('.entrance-frame');
+const content = document.querySelector('#campus-content');
+const header = document.querySelector('#site-header');
+const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
+const copy = entrance.querySelector('.entrance-copy');
+const arrival = entrance.querySelector('.entrance-arrival');
+const shade = entrance.querySelector('.entrance-shade');
+const flash = entrance.querySelector('.entrance-flash');
+const exit = entrance.querySelector('.entrance-exit');
+const progressBar = entrance.querySelector('.entrance-progress span');
+const topline = entrance.querySelector('.entrance-topline');
+const bottom = entrance.querySelector('.entrance-bottom');
+const clamp = n => Math.max(0,Math.min(1,n));
+const smooth = (a,b,n) => { const t=clamp((n-a)/(b-a)); return t*t*(3-2*t); };
+let scene = null, raf = 0, active = false, loading = false, failed = false;
+let position = 0, target = 0, start = 0, distance = 1;
+
+function measure() {
+  document.body.style.setProperty('--entrance-header', `${header.getBoundingClientRect().height}px`);
+  start = entrance.offsetTop - header.getBoundingClientRect().height;
+  distance = Math.max(1, entrance.offsetHeight - frame.offsetHeight);
+  scene?.resize();
+  schedule();
+}
+function apply(p) {
+  content.style.setProperty('--content-reveal', smooth(.85,.97,p));
+  content.inert = p < .85;
+  const intro = 1 - smooth(.015,.20,p);
+  copy.style.opacity = intro;
+  copy.style.transform = `translateY(${-p*100}px)`;
+  // Prevent keyboard focus from landing on a control after it fades away.
+  copy.inert = intro < .05;
+  arrival.style.opacity = smooth(.68,.76,p) * (1-smooth(.85,.95,p));
+  arrival.style.transform = `scale(${1+Math.max(0,p-.7)*.25})`;
+  shade.style.opacity = 1-smooth(.1,.35,p)*.8;
+  // Brief light bloom hides the scene boundary without a loading screen.
+  flash.style.opacity = smooth(.56,.638,p) * (1-smooth(.646,.71,p));
+  exit.style.opacity = smooth(.90,1,p);
+  topline.style.opacity = 1-smooth(.08,.25,p);
+  bottom.style.opacity = 1-smooth(.9,.98,p);
+  bottom.inert = p > .98;
+  progressBar.style.transform = `scaleX(${p})`;
+}
+function tick() {
+  raf = 0;
+  if (!scene || document.hidden || !active) return;
+  target = clamp((window.scrollY-start)/distance);
+  // Frame-rate independent damping; catch up immediately after a large jump.
+  const now = performance.now();
+  const dt = Math.min(64,now-(tick.last || now-16));
+  tick.last = now;
+  if (Math.abs(target-position) > .35) position = target;
+  else position += (target-position)*(1-Math.exp(-dt/75));
+  if (Math.abs(target-position)<.0003) position=target;
+  apply(position); scene.render(position);
+  if (position !== target) raf=requestAnimationFrame(tick);
+}
+function schedule() {
+  if (scene && active && !document.hidden && !raf) raf=requestAnimationFrame(tick);
+}
+function reset() {
+  cancelAnimationFrame(raf); raf=0;
+  scene?.dispose(); scene=null;
+  entrance.classList.remove('is-ready','is-enhanced');
+  for (const element of [copy,arrival,shade,flash,exit,topline,bottom,progressBar]) element.removeAttribute('style');
+  copy.inert=false; bottom.inert=false; content.inert=false;
+  content.style.removeProperty('--content-reveal');
+  measure();
+}
+async function enhance() {
+  if (reducedMotion.matches || loading || scene || failed || navigator.connection?.saveData) return;
+  loading=true;
+  try {
+    // No 3D download or GPU work for reduced motion or data-saving visitors.
+    const {createCampusScene}=await import('./campus-scene.js');
+    const result=await createCampusScene(entrance.querySelector('.entrance-canvas'),new URL('./images/campus-clean.webp',import.meta.url).href);
+    if (reducedMotion.matches) { result.dispose(); return; }
+    scene=result;
+    scene.canvas.addEventListener('webglcontextlost',event=>{
+      event.preventDefault(); failed=true; reset();
+    },{once:true});
+    // Don't move a visitor who already skipped/read beyond the static hero.
+    if (window.scrollY > entrance.offsetTop + entrance.offsetHeight - header.offsetHeight) {
+      scene.dispose(); scene=null; return;
+    }
+    entrance.classList.add('is-enhanced');
+    measure();
+    position=clamp((window.scrollY-start)/distance);
+    apply(position); scene.render(position);
+    entrance.classList.add('is-ready');
+    schedule();
+  } catch (error) {
+    failed=true; reset();
+    console.warn('Campus entrance: using the still-photo fallback.',error);
+  } finally { loading=false; }
+}
+// The page retains normal wheel, touch, keyboard and browser-history behavior.
+window.addEventListener('scroll',schedule,{passive:true});
+window.addEventListener('resize',measure,{passive:true});
+document.addEventListener('visibilitychange',schedule);
+window.addEventListener('pageshow',measure);
+new ResizeObserver(measure).observe(header);
+new IntersectionObserver(entries=>{
+  active=entries[0].isIntersecting;
+  if (active) { tick.last=0; schedule(); }
+  else { cancelAnimationFrame(raf); raf=0; }
+},{rootMargin:'100px'}).observe(entrance);
+reducedMotion.addEventListener('change',()=>{
+  if (reducedMotion.matches) reset(); else enhance();
+});
+for (const link of entrance.querySelectorAll('a[href="#campus-content"]')) {
+  link.addEventListener('click',event=>{
+    event.preventDefault();
+    // Instant skip is deliberate: no forced journey for keyboard/touch users.
+    if (scene) { position=1; apply(1); scene.render(1); }
+    content.scrollIntoView({behavior:'instant',block:'start'});
+    content.focus({preventScroll:true});
+    history.replaceState(null,'','#campus-content');
+  });
+}
+measure();
+// A direct fragment link must land on the content without subsequent layout shift.
+if (location.hash !== '#campus-content') enhance();
